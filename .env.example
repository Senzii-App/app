# Senzii — Environment Variables
# Copy to .env and fill in values.
# REQUIRED: SESSION_SECRET signs session cookies and OAuth JWTs (org_id + role)
# — the app refuses to start without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=
PORT=3000
SESSION_SECRET=
RESEND_API_KEY=
MAIL_FROM=
BASE_URL=
NOTIFY_EMAIL=
NOMINATIM_EMAIL=

# Session timeouts (seconds) — HIPAA automatic logoff
SESSION_IDLE_TIMEOUT_SECS=900
SESSION_ABSOLUTE_TIMEOUT_SECS=28800

# MCP server
ORG_ID=
MCP_PORT=3001