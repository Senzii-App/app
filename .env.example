# Senzii — Environment Variables
# Copy to .env and fill in values.

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
PORT=3000
SESSION_SECRET=change-me-to-a-random-string
RESEND_API_KEY=
MAIL_FROM=Senzii <noreply@senzii.com>
BASE_URL=https://senzii.com
NOTIFY_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NOMINATIM_EMAIL=

# Session timeouts (seconds) — HIPAA automatic logoff
SESSION_IDLE_TIMEOUT_SECS=900
SESSION_ABSOLUTE_TIMEOUT_SECS=28800

# MCP server
ORG_ID=
MCP_PORT=3001